{
  "schema_version": "1.1",
  "title": "RestoreRadar restoration industry statistics from 550 published provider records",
  "publisher": "RestoreRadar",
  "url": "https://restoreradar.com/restoration-market-data/",
  "license_url": "https://restoreradar.com/restoration-market-data/#reuse-terms",
  "methodology_url": "https://restoreradar.com/restoration-market-data/#methodology",
  "data_dictionary_url": "https://restoreradar.com/restoration-market-data/#data-dictionary",
  "verification_standard_url": "https://restoreradar.com/verification-standard/",
  "date_modified": "2026-07-30",
  "citation": "RestoreRadar, “Restoration Industry Statistics from 550 Provider Records,” updated 2026-07-30, https://restoreradar.com/restoration-market-data/",
  "update_frequency": "Recomputed with each published RestoreRadar data refresh; no fixed calendar schedule.",
  "reuse_terms": "RestoreRadar grants permission to use, analyze, quote, and redistribute these aggregate files, including modified extracts, with attribution to RestoreRadar and a link to the report. This permission covers RestoreRadar’s aggregation and presentation only; it does not grant rights in underlying third-party source data, provider names, logos, or trademarks. Preserve the published limitations when reporting comparisons.",
  "coverage_note": "Aggregate signals from the independent restoration provider listings currently published by RestoreRadar across its covered metros.",
  "limitations": [
    "This is not a census of every restoration company operating in each metro.",
    "A missing signal means RestoreRadar did not confirm it; it does not establish that a provider lacks the attribute.",
    "Provider-stated 24/7 response and direct insurance billing are statements observed on provider websites, not independent performance tests.",
    "Service rows overlap because one provider may list more than one restoration service."
  ],
  "source_classes": [
    {
      "id": "provider_websites",
      "name": "Provider websites",
      "supports": [
        "service classification",
        "provider-stated 24/7 response",
        "provider-stated direct insurance billing"
      ],
      "boundary": "Attributed provider statements only; not independent tests of availability, response time, or claims handling."
    },
    {
      "id": "google_business_profiles",
      "name": "Public Google Business Profiles",
      "url": "https://www.google.com/maps",
      "supports": [
        "public rating",
        "public review count",
        "matched public business location"
      ],
      "boundary": "Included only after the business identity is matched; ratings and review counts do not verify quality or future performance."
    },
    {
      "id": "iicrc_global_locator",
      "name": "IICRC Global Locator",
      "url": "https://locator.iicrc.org/",
      "supports": [
        "IICRC Certified Firm match"
      ],
      "boundary": "A missing match is unconfirmed, not proof that a provider lacks training or certification."
    },
    {
      "id": "state_mold_credentials",
      "name": "Official state mold-credential sources",
      "urls": [
        "https://www.tdlr.texas.gov/LicenseSearch/",
        "https://www.myfloridalicense.com/wl11.asp",
        "https://arlspublic.lslbc.louisiana.gov/Public/ClientSearch"
      ],
      "supports": [
        "eligible named state mold credential"
      ],
      "boundary": "Credential type and scope differ by state; provider-specific receipts carry the narrower claim and limitation."
    }
  ],
  "data_dictionary": [
    {
      "field": "metro_slug",
      "type": "string",
      "applies_to": [
        "metros"
      ],
      "definition": "Canonical RestoreRadar path slug for the covered metro."
    },
    {
      "field": "city",
      "type": "string",
      "applies_to": [
        "metros"
      ],
      "definition": "Primary city name used for the RestoreRadar metro."
    },
    {
      "field": "state",
      "type": "string",
      "applies_to": [
        "metros"
      ],
      "definition": "Two-letter U.S. state abbreviation."
    },
    {
      "field": "service_slug",
      "type": "string",
      "applies_to": [
        "services"
      ],
      "definition": "Canonical RestoreRadar path slug for the restoration service."
    },
    {
      "field": "service",
      "type": "string",
      "applies_to": [
        "services"
      ],
      "definition": "Reader-facing restoration service name."
    },
    {
      "field": "metros_represented",
      "type": "integer",
      "minimum": 0,
      "applies_to": [
        "services"
      ],
      "definition": "Covered metros containing at least one listed provider record classified for the service."
    },
    {
      "field": "listed_providers",
      "type": "integer",
      "minimum": 0,
      "applies_to": [
        "totals",
        "metros",
        "services"
      ],
      "definition": "Published RestoreRadar provider records in the stated slice; not a census of all operating companies."
    },
    {
      "field": "provider_stated_24_7",
      "type": "integer",
      "minimum": 0,
      "applies_to": [
        "totals",
        "metros",
        "services"
      ],
      "definition": "Listed records whose provider website states 24/7 response; not an independent availability or response-time test."
    },
    {
      "field": "provider_stated_insurance_direct_billing",
      "type": "integer",
      "minimum": 0,
      "applies_to": [
        "totals",
        "metros",
        "services"
      ],
      "definition": "Listed records whose provider website states direct insurance billing; not an independent claims-handling test."
    },
    {
      "field": "google_rated_listings",
      "type": "integer",
      "minimum": 0,
      "applies_to": [
        "totals",
        "metros",
        "services"
      ],
      "definition": "Listed records with a public Google rating attached to a matched business identity."
    },
    {
      "field": "google_review_total",
      "type": "integer",
      "minimum": 0,
      "applies_to": [
        "totals",
        "metros",
        "services"
      ],
      "definition": "Sum of public Google review counts represented by the matched rated listings; individual reviews are not included."
    },
    {
      "field": "domain_matched_google_business_locations",
      "type": "integer",
      "minimum": 0,
      "applies_to": [
        "totals",
        "metros",
        "services"
      ],
      "definition": "Listed records with a Google Business location matched by website domain or another approved identity key."
    },
    {
      "field": "iicrc_certified_firms",
      "type": "integer",
      "minimum": 0,
      "applies_to": [
        "totals",
        "metros",
        "services"
      ],
      "definition": "Listed records matched to a current IICRC Certified Firm entry under RestoreRadar verification rules."
    },
    {
      "field": "official_state_mold_credentials",
      "type": "integer",
      "minimum": 0,
      "applies_to": [
        "totals",
        "metros",
        "services"
      ],
      "definition": "Listed records with an eligible mold credential matched in an official Texas, Florida, or Louisiana state source; the credential scope differs by state."
    }
  ],
